# Optional remote AR manifest. If unset, app uses /assets/ar/manifest.json.
VITE_AR_MANIFEST_URL=

# Optional cloud scene API. The frontend falls back to the static catalog if
# this API is unavailable.
VITE_AR_SCENE_API_URL=/api/scenes
VITE_AR_RECOGNITION_API_URL=/api/recognize
VITE_AR_RECOGNITION_EVENTS_URL=off
VITE_AR_TENANT=emo
VITE_AR_LOCATION=store-a

# Local Docker Postgres default for scripts and Vercel dev.
DATABASE_URL=postgres://emo:emo@127.0.0.1:5432/emo_ar
AR_SCENE_CACHE_SECONDS=60
AR_SCENE_MAX_RESULTS=0

# Local/offline recognition index build. The source images stay outside this
# repo; only the generated descriptor index is committed/deployed.
AR_RECOGNITION_SOURCE_ROOT=../emo-checklist-source-archive
AR_RECOGNITION_MIN_CONFIDENCE=0.76
AR_RECOGNITION_MIN_SCENE_MARGIN=0.02
AR_RECOGNITION_STRONG_CONFIDENCE=0.93
